{
  "total": 62.32,
  "cues": [
    {
      "i": 0,
      "id": "vo_00",
      "text": "你丟給 AI 五百億筆商品，",
      "start": 0.5,
      "end": 3.332,
      "dur": 2.832,
      "file": "vo_00.mp3"
    },
    {
      "i": 1,
      "id": "vo_01",
      "text": "它不會變聰明，只會把你淹沒。",
      "start": 3.682,
      "end": 7.162,
      "dur": 3.48,
      "file": "vo_01.mp3"
    },
    {
      "i": 2,
      "id": "vo_02",
      "text": "聰明人要的，是一張剛剛好的比較表。",
      "start": 7.512,
      "end": 11.448,
      "dur": 3.936,
      "file": "vo_02.mp3"
    },
    {
      "i": 3,
      "id": "vo_03",
      "text": "這才是 Gemini 購物，真正好用的地方。",
      "start": 11.798,
      "end": 15.662,
      "dur": 3.864,
      "file": "vo_03.mp3"
    },
    {
      "i": 4,
      "id": "vo_04",
      "text": "過去想買台套房除濕機，你得猜關鍵字、爬開箱文，",
      "start": 16.262,
      "end": 21.518,
      "dur": 5.256,
      "file": "vo_04.mp3"
    },
    {
      "i": 5,
      "id": "vo_05",
      "text": "開十幾個分頁，在各家電商之間眼花撩亂。",
      "start": 21.868,
      "end": 26.188,
      "dur": 4.32,
      "file": "vo_05.mp3"
    },
    {
      "i": 6,
      "id": "vo_06",
      "text": "Gemini 真正改變的，是把混亂的視窗一鍵收合成規格表。",
      "start": 26.538,
      "end": 32.01,
      "dur": 5.472,
      "file": "vo_06.mp3"
    },
    {
      "i": 7,
      "id": "vo_07",
      "text": "但搬到台灣電商，它會立刻撞上兩道大牆：",
      "start": 32.61,
      "end": 36.93,
      "dur": 4.32,
      "file": "vo_07.mp3"
    },
    {
      "i": 8,
      "id": "vo_08",
      "text": "會員專屬的登入牆，以及滿天飛的隱藏折價券。",
      "start": 37.28,
      "end": 41.984,
      "dur": 4.704,
      "file": "vo_08.mp3"
    },
    {
      "i": 9,
      "id": "vo_09",
      "text": "AI 抓得到公開標價，卻穿不透登入後的真實底價。",
      "start": 42.334,
      "end": 47.254,
      "dur": 4.92,
      "file": "vo_09.mp3"
    },
    {
      "i": 10,
      "id": "vo_10",
      "text": "所以，別把它當成一鍵搶便宜的神器，",
      "start": 47.854,
      "end": 51.934,
      "dur": 4.08,
      "file": "vo_10.mp3"
    },
    {
      "i": 11,
      "id": "vo_11",
      "text": "把它當成幫你精準過濾規格的選品特助。",
      "start": 52.284,
      "end": 56.196,
      "dur": 3.912,
      "file": "vo_11.mp3"
    },
    {
      "i": 12,
      "id": "vo_12",
      "text": "懂這層邊界，你才算真正用懂了 AI 購物。",
      "start": 56.546,
      "end": 60.77,
      "dur": 4.224,
      "file": "vo_12.mp3"
    }
  ]
}